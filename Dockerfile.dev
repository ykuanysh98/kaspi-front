# Base image ретінде Node.js 20-тің жеңілдетілген нұсқасын аламыз
FROM node:20-alpine

# Контейнер ішіндегі жұмыс папкасын белгілейміз
WORKDIR /app

# Тәуелділіктерді (dependencies) кэштеу үшін файлдарды алдын-ала көшіреміз
COPY package.json yarn.lock ./

# Барлық кітапханаларды орнатамыз
RUN yarn install

# Локалды компьютердегі қалған кодтың бәрін контейнер ішіне көшіреміз
COPY . .

# Nuxt сыртқы сұраныстарды қабылдай алуы үшін HOST пен PORT өзгертулерін енгіземіз
ENV HOST=0.0.0.0
ENV PORT=3000

# 3000 портын контейнерден тысқары шығарамыз
EXPOSE 3000

# Әзірлеу режимінде іске қосамыз
CMD ["yarn", "dev"]
